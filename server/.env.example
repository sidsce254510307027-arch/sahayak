# Copy to .env for local dev, or set as environment variables on Render
NODE_ENV=development
PORT=3001
JWT_SECRET=change-this-to-a-random-string

# Admin console password — only people who know this can open the admin panel.
# CHANGE THIS before deploying. Owners log in with this password, not a phone number.
ADMIN_PASSWORD=sahayak-admin

# SMS Provider (uncomment when ready)
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=your-key
# MSG91_TEMPLATE_ID=your-template-id

# Encryption key for Aadhaar numbers at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset it falls back to JWT_SECRET, which is fine for local dev but not production.
# AADHAAR_KEY=
